{
  "name": "bedrock",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:production": "pnpm -r --if-present run build:production",
    "start": "pnpm -r --if-present run start",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "lint:js": "pnpm -r --if-present run lint:js",
    "lint:css": "pnpm -r --if-present run lint:css",
    "lint:prettier": "pnpm -r --if-present run lint:prettier",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "lint:fix:prettier": "pnpm -r --if-present run lint:fix:prettier",
    "lint:fix:js": "pnpm -r --if-present run lint:fix:js",
    "lint:fix:css": "pnpm -r --if-present run lint:fix:css",
    "ci:scripts": "pnpm -r --if-present --silent run ci:scripts",
    "ci:styles": "pnpm -r --if-present --silent run ci:styles",
    "translate": "pnpm -r --if-present run translate",
    "translate:pot": "pnpm -r --if-present run translate:pot",
    "translate:js": "pnpm -r --if-present run translate:js",
    "e2e:install": "pnpm install --ignore-workspace --no-lockfile --ignore-scripts",
    "e2e:test": "npx playwright test '^(?!.*(visual|editor)).*\\.spec\\.js' --config=./test/e2e/playwright.config.js",
    "e2e:editor": "npx playwright test editor.spec.js --config=./test/e2e/playwright.config.js",
    "e2e:visual": "npx playwright test visual.spec.js --config=./test/e2e/playwright.config.js",
    "e2e:visual:update": "npx playwright test visual.spec.js --config=./test/e2e/playwright.config.js --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@wordpress/eslint-plugin": "^28.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
