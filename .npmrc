# FontAwesome Pro is not on the public registry. npm never needed this stated:
# package-lock.json carried the full `resolved` URL per package, so CI resolved
# it from the lockfile and the mapping lived only in each developer's ~/.npmrc.
# pnpm resolves fresh, so an unstated mapping means a 404 against
# registry.npmjs.org.
#
# The 7-day release-age cooldown that used to live here is now
# `minimumReleaseAge` in pnpm-workspace.yaml.
@fortawesome:registry=https://npm.fontawesome.com/
