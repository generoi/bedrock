# OS X .gitignore
.DS_Store
.AppleDouble
.LSOverride

# Application
web/app/plugins/*
!web/app/plugins/genero-woocommerce
!web/app/plugins/.gitkeep
web/app/mu-plugins/*/
web/app/languages/*
web/app/upgrade
web/app/uploads/*
web/app/cache/*
!web/app/uploads/.gitkeep
web/app/advanced-cache.php
web/genero-status.php
web/app/mu-plugins/wp-cli-login-server.php
wp-translation-downloader.lock

# WordPress
web/wp

# Logs
*.log

# Dotenv
.env
.env.*
!.env.example

# Composer
/vendor
auth.json

# Node Package Manager
node_modules
npm-debug.log
yarn-error.log

# Vagrant
.vagrant

# Deployer
.build

# Logs
log
*.log

# Sensitive files
*.sql

# Local configuration
local.config.yml

# WP-CLI
wp-cli.local.yml

# Claude Code
.claude/settings.local.json
.claude/worktrees/
.playwright-mcp/

# hostshift's README has you write this uploads mount per worktree, and it
# hardcodes a sibling path valid on one machine. Everything the add-on itself
# installs it ignores in .git/info/exclude, which covers every checkout.
.ddev/docker-compose.uploads.yaml

# Unit tests
.phpunit.cache
.phpunit.result.cache
screenshot.jpg
test-results

# Theme
web/app/themes/*/public