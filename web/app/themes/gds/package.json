{
  "name": "gds",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wp-scripts build",
    "build:production": "wp-scripts build",
    "start": "wp-scripts start",
    "test": "pnpm run lint",
    "lint": "pnpm run lint:prettier && pnpm run lint:js && pnpm run lint:css",
    "lint:js": "wp-scripts lint-js resources --cache",
    "lint:css": "stylelint 'resources/**/*.{css,scss}' --cache",
    "lint:prettier": "prettier --check --cache .",
    "lint:fix": "pnpm run lint:fix:prettier && pnpm run lint:fix:js && pnpm run lint:fix:css",
    "lint:fix:prettier": "prettier --write --cache .",
    "lint:fix:js": "wp-scripts lint-js resources --fix --cache",
    "lint:fix:css": "stylelint 'resources/**/*.{css,scss}' --fix --cache",
    "ci:scripts": "wp-scripts lint-js resources/scripts --format checkstyle",
    "ci:styles": "stylelint 'resources/**/*.{css,scss}' -f json 2>&1 | npx stylelint-checkstyle-reporter",
    "translate": "pnpm run translate:pot && pnpm run translate:js",
    "translate:pot": "pnpm run wp -- i18n make-pot . ./resources/lang/gds.pot --domain=gds --include=\"app,resources\"",
    "translate:js": "pnpm run wp -- i18n make-json ./resources/lang --domain=gds --extensions=jsx --pretty-print",
    "wp": "../../../../vendor/bin/wp"
  },
  "devDependencies": {
    "@shufo/prettier-plugin-blade": "^1.16.2",
    "@wordpress/scripts": "~37.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint-formatter-checkstyle": "^9.0.1",
    "postcss-inline-svg": "^6.0.0",
    "stylelint-checkstyle-reporter": "^1.1.1",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-pro": "^7.3.1",
    "@types/wordpress__blocks": "^12.5.14",
    "@wordpress/base-styles": "^13.2.0",
    "clsx": "^2.1.1",
    "lodash-es": "^4.18.1",
    "modern-normalize": "^3.0.1",
    "sass-mq": "^7.0"
  }
}
