{
  "$schema": "https://raw.githubusercontent.com/composer/composer/main/res/composer-schema.json",
  "name": "generoi/bedrock",
  "type": "project",
  "license": "MIT",
  "description": "WordPress boilerplate with modern development tools, easier configuration, and an improved folder structure",
  "homepage": "https://roots.io/bedrock/",
  "authors": [
    {
      "name": "Scott Walkinshaw",
      "email": "scott.walkinshaw@gmail.com",
      "homepage": "https://github.com/swalkinshaw"
    },
    {
      "name": "Ben Word",
      "email": "ben@benword.com",
      "homepage": "https://github.com/retlehs"
    }
  ],
  "keywords": [
    "bedrock",
    "composer",
    "roots",
    "wordpress",
    "wp",
    "wp-config"
  ],
  "support": {
    "issues": "https://github.com/roots/bedrock/issues",
    "forum": "https://discourse.roots.io/category/bedrock"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    },
    {
      "type": "composer",
      "url": "https://generoi.github.io/packagist/"
    }
  ],
  "require": {
    "php": ">=8.5",
    "composer/installers": "^2.3",
    "koodimonni/composer-dropin-installer": "^1.4",
    "cweagans/composer-patches": "^2.0",
    "vlucas/phpdotenv": "^5.6",
    "roots/wordpress": "^7.1",
    "oscarotero/env": "^2.1",
    "roots/wp-config": "^1.0",
    "jjgrainger/posttypes": "^3.0",
    "roots/bedrock-autoloader": "^1.1",
    "kinsta/kinsta-mu-plugins": "^3.7",
    "inpsyde/wp-translation-downloader": "^2.6",
    "consolidation/robo": "^5.1",
    "generoi/robo-genero": "^0.5.3",
    "wp-cli/wp-cli-bundle": "^2.11",
    "aaemnnosttv/wp-cli-login-command": "^1.5",
    "roots/acorn": "^6.3",
    "log1x/navi": "^3.1",
    "log1x/sage-svg": "^2.0",
    "spatie/laravel-csp": "^3.31",
    "spatie/laravel-google-fonts": "^1.7",
    "generoi/sage-cachetags": "^2.5.3",
    "generoi/sage-woocommerce": "^1.1.7",
    "generoi/advanced-custom-fields-pro": "^6.8",
    "generoi/gravityforms": "^3.2",
    "generoi/polylang-pro": "^3.9",
    "generoi/wp-image-resizer": "^1.5.2",
    "generoi/wp-gutenberg-shy": "^0.2.1",
    "generoi/gds-security-hardening": "^2.4",
    "generoi/gds-llms": "^0.4.3",
    "generoi/gds-assistant": "^0.5",
    "generoi/gds-mcp": "^0.8.3",
    "wordpress/mcp-adapter": "^0.7.1",
    "wp-plugin/cookiebot": "^4.7",
    "wp-plugin/limit-login-attempts-reloaded": "^3.4",
    "wp-plugin/postmark-approved-wordpress-plugin": "^1.19",
    "wp-plugin/query-monitor": "^4.0",
    "wp-plugin/safe-redirect-manager": "^2.2",
    "wp-plugin/safe-svg": "^2.5",
    "wp-plugin/show-environment-in-admin-bar": "^1.2",
    "wp-plugin/theme-translation-for-polylang": "^3.4",
    "wp-plugin/user-switching": "^1.9",
    "wp-plugin/woocommerce": "^11.2",
    "wp-plugin/wordpress-seo": "^28.8",
    "wp-plugin/wp-sanitize-file-name-plus": "^1.0"
  },
  "require-dev": {
    "brainmaestro/composer-git-hooks": "^3.0",
    "deployer/deployer": "^8.0",
    "generoi/deployer-genero": "^0.4.5",
    "laravel/pint": "^1.32",
    "makers99/wp-cli-db-export-clean": "^1.0",
    "phpunit/phpunit": "^9.6",
    "staabm/annotate-pull-request-from-checkstyle": "^1.8",
    "wp-phpunit/wp-phpunit": "^7.1",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "dropin-installer": "copy",
    "platform": {
      "php": "8.5.0"
    },
    "process-timeout": 0,
    "theme-dir": "web/app/themes/gds",
    "allow-plugins": {
      "automattic/jetpack-autoloader": true,
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "inpsyde/wp-translation-downloader": true,
      "cweagans/composer-patches": true,
      "koodimonni/composer-dropin-installer": true
    },
    "prepend-autoloader": false,
    "sort-packages": true,
    "audit": {
      "ignore": {
        "WPSECADV/WF/112ed4f2-fe91-4d83-a3f7-eaf889870af4/wordpress": "WP core unfixed — CVE-2022-3590 SSRF, no patched release.",
        "WPSECADV/WF/9fda5e15-fdf9-4b67-93d3-2dbfa94aefe9/wordpress": "WP core unfixed — paired SSRF/disclosure advisory, no patched release.",
        "WPSECADV/WF/ee5af42d-71d8-4e65-bd74-55456480da8b/wp-image-resizer": "False positive — wpsecadv 2013 advisory targets a different unrelated WordPress.org plugin that happens to share the slug 'wp-image-resizer'. Our generoi/wp-image-resizer is unrelated."
      }
    }
  },
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\": "web/app/themes/gds/app/",
      "GeneroWoo\\Woocommerce\\": "web/app/plugins/genero-woocommerce/src/"
    }
  },
  "extra": {
    "dropin-paths": {
      "web/app/mu-plugins": [
        "package:aaemnnosttv/wp-cli-login-command:plugin/wp-cli-login-server.php"
      ],
      "web/": [
        "package:generoi/genero-status:genero-status.php"
      ]
    },
    "hooks": {
      "pre-commit": "composer lint:fix",
      "post-merge": "composer install:development"
    },
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin",
        "wp-plugin/show-environment-in-admin-bar"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp",
    "wp-translation-downloader": {
      "languages": [
        "fi",
        "sv_SE"
      ],
      "api": {
        "names": {
          "generoi/gravityforms": "https://packages.translationspress.com/rocketgenius/gravityforms/packages.json"
        }
      },
      "excludes": [
        "generoi/advanced-custom-fields-pro",
        "generoi/gds-assistant",
        "generoi/gds-llms",
        "generoi/gds-mcp",
        "generoi/gds-security-hardening",
        "generoi/polylang-pro",
        "generoi/wp-gutenberg-shy",
        "generoi/wp-image-resizer",
        "wp-plugin/limit-login-attempts-reloaded",
        "wp-plugin/query-monitor",
        "wp-plugin/safe-svg",
        "wp-plugin/show-environment-in-admin-bar",
        "wp-plugin/user-switching",
        "wp-plugin/wp-sanitize-file-name-plus"
      ],
      "languageRootDir": "web/app/languages"
    },
    "patches": {
      "generoi/advanced-custom-fields-pro": {
        "Fix get_block_wrapper_attributes not working with ACF preview": "./config/patches/acf-get_block_wrapper_attributes.patch"
      },
      "aaemnnosttv/wp-cli-login-command": {
        "Add support for url prefix": "./config/patches/wp-cli-login-command-add-support-for-url-prefix.patch"
      },
      "wp-plugin/cookiebot": {
        "Print script tags through the core API so they carry the CSP nonce": "./config/patches/cookiebot-support-csp.patch"
      }
    }
  },
  "scripts": {
    "post-create-project-cmd": "Generoi\\Robo\\Composer\\ComposerScript::postCreateProject",
    "post-update-cmd": "php -r \"if (is_executable('vendor/bin/cghooks')) exec('vendor/bin/cghooks update');\"",
    "test": [
      "@composer validate --no-check-all",
      "@composer lint"
    ],
    "phpunit": "phpunit",
    "lint": [
      "pint --test",
      "npm run lint"
    ],
    "lint:fix": [
      "pint --quiet",
      "npm run lint:fix",
      "pint --quiet web/app/plugins/genero-woocommerce/src/"
    ],
    "ci": [
      "@composer validate --no-check-all",
      "env -u AI_AGENT -u CLAUDECODE pint --format=checkstyle | vendor/bin/cs2pr",
      "npm run ci:scripts --silent | while read xml; do echo $xml | ./vendor/bin/cs2pr; done",
      "npm run ci:styles --silent | while read xml; do echo $xml | ./vendor/bin/cs2pr; done"
    ],
    "build": [
      "npm install",
      "npm run lint",
      "npm run build:production"
    ],
    "install:development": [
      "@composer install",
      "@composer build",
      "vendor/bin/cghooks update"
    ],
    "db:export-clean": [
      "ddev wp db export-clean .github/fixtures/sanitized-db.sql --remove-keys",
      "gzip -kf .github/fixtures/sanitized-db.sql"
    ],
    "post-autoload-dump": [
      "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
    ]
  }
}
